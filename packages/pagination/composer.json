{
    "name": "module/pagination",
    "description": "Base Eloquent builder with request-driven pagination (`per_page`, `page`) for Laravel.",
    "keywords": [
        "laravel",
        "eloquent",
        "builder",
        "pagination"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Module\\Pagination\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Module\\Pagination\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Module\\Pagination\\PaginationServiceProvider"
            ]
        }
    }
}
